<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Argus.Ui">

    <!-- 숫자 입력 칸의 위/아래 화살표 버튼. 색은 앱 테마 리소스를 그대로 쓴다. -->
    <Style x:Key="NumberBoxArrow" TargetType="RepeatButton">
        <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        <Setter Property="Background" Value="{DynamicResource Surface2}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Delay" Value="400"/>
        <Setter Property="Interval" Value="60"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="{TemplateBinding Tag}">
                        <TextBlock Text="{TemplateBinding Content}" FontFamily="{DynamicResource IconFont}" FontSize="9"
                                   Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Surface3}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:NumberBox}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:NumberBox}">
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="PART_Text" Width="{TemplateBinding TextWidth}" TextAlignment="Right" VerticalContentAlignment="Center"/>
                        <Grid Width="24" Margin="4,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <RepeatButton x:Name="PART_Up" Style="{StaticResource NumberBoxArrow}" Content="&#xE70E;" Tag="6,6,0,0" ToolTip="올리기 (Shift: 10배)"/>
                            <RepeatButton x:Name="PART_Down" Grid.Row="1" Style="{StaticResource NumberBoxArrow}" Content="&#xE70D;" Tag="0,0,6,6" ToolTip="내리기 (Shift: 10배)"/>
                        </Grid>
                        <TextBlock Text="{TemplateBinding Unit}" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
