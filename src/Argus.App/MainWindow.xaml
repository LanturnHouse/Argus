<Window x:Class="Argus.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Argus" Icon="Argus.ico" Height="820" Width="1200" MinHeight="640" MinWidth="1160"
        Background="{StaticResource Bg}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 사이드바 -->
        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,18,14,14">
                <StackPanel DockPanel.Dock="Top" Margin="6,0,0,22">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="Assets/ArgusLogo.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="ARGUS" FontSize="18" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="12,10" CornerRadius="10" Background="{StaticResource Surface2}">
                    <StackPanel>
                        <TextBlock Text="실행 중인 클라이언트" Style="{StaticResource Dim}"/>
                        <TextBlock x:Name="ClientCount" Text="0" FontSize="22" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <!-- 전투 / 비전투 모드: 비전투에서는 전투 로그 · 태클 감지 · 프리뷰 수치 · 레드박싱을 멈춰 리소스를 아낀다 -->
                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="12,10" CornerRadius="10" Background="{StaticResource Surface2}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="모드" Style="{StaticResource Dim}"/>
                        <Border Style="{StaticResource SegmentBar}" Margin="0,6,0,0" HorizontalAlignment="Stretch">
                            <UniformGrid Rows="1">
                                <RadioButton x:Name="ModeCombat" GroupName="mode" Content="전투" Style="{StaticResource Segment}" Checked="Mode_Checked"/>
                                <RadioButton x:Name="ModeIdle" GroupName="mode" Content="비전투" Style="{StaticResource Segment}" Checked="Mode_Checked"/>
                            </UniformGrid>
                        </Border>
                        <TextBlock x:Name="ModeNote" Style="{StaticResource Dim}" FontSize="11.5" TextWrapping="Wrap" Margin="2,6,0,0"/>
                    </StackPanel>
                </Border>

                <ListBox x:Name="Nav" SelectionChanged="Nav_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="16"
                                           Width="24" VerticalAlignment="Center" Foreground="{StaticResource TextDim}"/>
                                <TextBlock Text="{Binding Title}" FontSize="14" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 콘텐츠 -->
        <ContentPresenter x:Name="Page" Grid.Column="1" Margin="24"/>
    </Grid>
</Window>
