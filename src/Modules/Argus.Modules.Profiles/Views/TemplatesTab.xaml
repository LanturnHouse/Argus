<UserControl x:Class="Argus.Modules.Profiles.TemplatesTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 왼쪽: EVE 설정 폴더의 캐릭터 -->
        <Border Style="{DynamicResource Card}" Padding="0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,14,16,10">
                    <TextBlock Text="1. EVE 설정 폴더에서 캐릭터 선택" Style="{DynamicResource CardTitle}"/>
                    <DockPanel Margin="0,10,0,0">
                        <Button DockPanel.Dock="Right" Content="새로고침" Margin="8,0,0,0" Padding="12,6" Click="Refresh_Click"/>
                        <TextBlock x:Name="FolderLabel" Style="{DynamicResource Dim}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </DockPanel>
                    <TextBlock x:Name="FolderNote" Style="{DynamicResource Dim}" Margin="0,4,0,0" Text="폴더는 설정 페이지에서 변경합니다."/>
                </StackPanel>
                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                    <Grid>
                        <TextBlock x:Name="CharEmpty" Style="{DynamicResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Text="캐릭터 설정파일(core_char_*.dat)을 찾지 못했습니다."/>
                        <ListBox x:Name="CharList" Margin="8" SelectionChanged="Char_Selected">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock x:Name="state" DockPanel.Dock="Right" Text="{Binding State}" FontSize="11"
                                                       Foreground="{DynamicResource Danger}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Detail}" Style="{DynamicResource Dim}" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding Warn}" FontSize="11" Foreground="#E5A03A" Margin="0,2,0,0" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Warn}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </DockPanel>
        </Border>

        <!-- 오른쪽: 저장 폼 + 저장된 설정파일 -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Style="{DynamicResource Card}">
                <StackPanel>
                    <TextBlock Text="2. 설정파일 이름을 정해 저장" Style="{DynamicResource CardTitle}"/>
                    <TextBlock x:Name="SelectedText" Style="{DynamicResource Dim}" Margin="0,8,0,0" Text="왼쪽에서 캐릭터를 선택하세요."/>
                    <DockPanel Margin="0,10,0,0">
                        <Button x:Name="SaveBtn" DockPanel.Dock="Right" Content="저장" Margin="8,0,0,0" Padding="22,8"
                                Style="{DynamicResource PrimaryButton}" Click="Save_Click" IsEnabled="False"/>
                        <Grid>
                            <TextBox x:Name="NameBox" MaxLength="40" TextChanged="Name_Changed" KeyDown="Name_KeyDown"/>
                            <TextBlock x:Name="NameHint" Text="설정파일 이름 (예: 메인 UI, 스카우트용)" Style="{DynamicResource Dim}"
                                       Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                    </DockPanel>
                    <TextBlock x:Name="SaveNote" Style="{DynamicResource Dim}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{DynamicResource Card}" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="16,12" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <TextBlock x:Name="TemplateCount" DockPanel.Dock="Right" Style="{DynamicResource Dim}" VerticalAlignment="Center"/>
                            <TextBlock Text="저장된 설정파일" Style="{DynamicResource CardTitle}"/>
                        </DockPanel>
                    </Border>
                    <Grid>
                        <TextBlock x:Name="TemplateEmpty" Style="{DynamicResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Text="아직 저장한 설정파일이 없습니다."/>
                        <ListBox x:Name="TemplateList" Margin="8" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="{DynamicResource Surface2}" CornerRadius="8" Padding="12,9" Margin="0,0,0,6">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="삭제" Padding="12,4" Tag="{Binding Info}" Click="DeleteTemplate_Click"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Detail}" Style="{DynamicResource Dim}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
