<UserControl x:Class="Argus.Modules.Profiles.ApplyTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 프리셋 선택 -->
        <Border Style="{DynamicResource Card}" Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="16,12" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                    <TextBlock Text="1. 적용할 프리셋 선택" Style="{DynamicResource CardTitle}"/>
                </Border>
                <Grid>
                    <TextBlock x:Name="ListEmpty" Style="{DynamicResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Text="프리셋이 없습니다. '프리셋' 탭에서 만드세요."/>
                    <ListBox x:Name="PresetList" Margin="8" SelectionChanged="Preset_Selected">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Entries.Count, StringFormat={}{0}명}" Style="{DynamicResource Dim}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 적용 전 확인 -->
            <Border Style="{DynamicResource Card}" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="16,12" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <Button x:Name="ApplyBtn" DockPanel.Dock="Right" Content="적용" Padding="26,8" Style="{DynamicResource PrimaryButton}"
                                    Click="Apply_Click" IsEnabled="False"/>
                            <Button x:Name="UndoBtn" DockPanel.Dock="Right" Content="직전 적용 되돌리기" Margin="0,0,8,0" Padding="14,8"
                                    Click="Undo_Click" IsEnabled="False"/>
                            <StackPanel>
                                <TextBlock Text="2. 적용 대상 확인" Style="{DynamicResource CardTitle}"/>
                                <TextBlock x:Name="PlanSummary" Style="{DynamicResource Dim}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Grid>
                        <TextBlock x:Name="PlanEmpty" Style="{DynamicResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Text="왼쪽에서 프리셋을 선택하세요."/>
                        <ListBox x:Name="PlanList" Margin="8" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="{DynamicResource Surface2}" CornerRadius="8" Padding="12,9" Margin="0,0,0,6">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" FontSize="12" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Ok}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Success}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding TemplateName, StringFormat=적용할 설정파일: {0}}" Style="{DynamicResource Dim}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- 결과 -->
            <Border Grid.Row="2" Style="{DynamicResource Card}" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="16,12" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <Button x:Name="RetryBtn" DockPanel.Dock="Right" Content="실패한 항목만 다시 적용" Padding="14,6"
                                    Click="Retry_Click" Visibility="Collapsed"/>
                            <StackPanel>
                                <TextBlock x:Name="ResultTitle" Text="3. 결과" Style="{DynamicResource CardTitle}"/>
                                <TextBlock x:Name="ResultSummary" Style="{DynamicResource Dim}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Grid>
                        <TextBlock x:Name="ResultEmpty" Style="{DynamicResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Text="적용하면 캐릭터별 결과가 여기에 표시됩니다."/>
                        <ListBox x:Name="ResultList" Margin="8" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Padding="8,5"><ContentPresenter/></Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Mark}" FontWeight="Bold" FontSize="15" Width="22">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Ok}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Success}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Name}" FontSize="14"/>
                                        <TextBlock Text="{Binding Reason}" Margin="8,0,0,0" FontSize="13" Foreground="{DynamicResource TextDim}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
