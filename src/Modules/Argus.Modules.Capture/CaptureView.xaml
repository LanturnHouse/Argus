<UserControl x:Class="Argus.Modules.Capture.CaptureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 클라이언트 목록 -->
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <TextBlock Text="화면 감시" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="클라이언트별로 독립 감시" Style="{DynamicResource Dim}" Margin="0,4,0,0"/>
            </StackPanel>
            <ListBox x:Name="ClientList" SelectionChanged="ClientList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Ellipse x:Name="dot" DockPanel.Dock="Left" Width="9" Height="9" Margin="0,0,10,0" VerticalAlignment="Center"
                                     Fill="{DynamicResource TextDim}"/>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Note}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                           Foreground="{DynamicResource AccentHover}" Margin="0,1,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentHover}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Note}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Status}" Style="{DynamicResource Dim}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                            </StackPanel>
                        </DockPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Running}" Value="True">
                                <Setter TargetName="dot" Property="Fill" Value="{DynamicResource Success}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <TextBlock x:Name="NoClient" Grid.Column="2" Text="감시할 클라이언트가 없습니다. EVE에 로그인하면 자동으로 나타납니다."
                   Style="{DynamicResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- 상세 -->
        <Grid Grid.Column="2" x:Name="Detail" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 헤더: 이름 / 메모 / 상태 / 시작 버튼 -->
            <DockPanel Margin="0,0,0,14">
                <Button x:Name="ToggleBtn" DockPanel.Dock="Right" ToolTipService.ShowOnDisabled="True" Padding="22,10" MinWidth="120" VerticalAlignment="Top"
                        Click="Toggle_Click" Style="{DynamicResource PrimaryButton}" Content="▶  감시 시작"/>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock x:Name="CharName" FontSize="24" FontWeight="Bold"/>
                    <Grid Margin="0,8,0,0">
                        <TextBox x:Name="NoteBox" MaxLength="120" LostFocus="Note_LostFocus" KeyDown="Note_KeyDown"/>
                        <TextBlock x:Name="NoteHint" Text="감시 대상 메모 — 예: 적 스트럭처 200km 지정 감시"
                                   Style="{DynamicResource Dim}" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Ellipse x:Name="StateDot" Width="8" Height="8" Fill="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Style="{DynamicResource Dim}" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <!-- 감시 영역 -->
            <Border Grid.Row="1" Style="{DynamicResource Card}" Margin="0,0,0,12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ViewBtn" Content="영역 보기" Padding="18,10" Margin="0,0,8,0" Click="ViewRegion_Click"
                                ToolTip="현재 감시 중인 영역을 실시간으로 확인합니다"/>
                        <Button x:Name="PickBtn" Padding="20,10" Style="{DynamicResource PrimaryButton}" Click="PickRegion_Click" Content="영역 지정"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="감시 영역" Style="{DynamicResource CardTitle}" VerticalAlignment="Center"/>
                            <Border x:Name="RoiBadge" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" Background="{DynamicResource AccentSoft}">
                                <TextBlock x:Name="RoiLabel" FontSize="12" Foreground="{DynamicResource AccentHover}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="RoiHint" Style="{DynamicResource Dim}" Margin="0,6,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 감지 기록 -->
            <Border Grid.Row="2" Style="{DynamicResource Card}" Padding="0" Margin="0,0,0,12">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="16,12" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <TextBlock x:Name="LogCount" DockPanel.Dock="Right" Style="{DynamicResource Dim}" VerticalAlignment="Center"/>
                            <TextBlock Text="감지 기록" Style="{DynamicResource CardTitle}"/>
                        </DockPanel>
                    </Border>
                    <Grid>
                        <TextBlock x:Name="LogEmpty" Text="아직 감지된 변화가 없습니다." Style="{DynamicResource Dim}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <ListBox x:Name="LogList" Margin="8" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="{DynamicResource Surface2}" CornerRadius="8" Padding="12,9" Margin="0,0,0,6">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="열기" Padding="12,4" Tag="{Binding Path}"
                                                Visibility="{Binding OpenVisibility}" Click="OpenFile_Click"/>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding TimeText}" FontWeight="SemiBold" Width="80" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Detail}" Style="{DynamicResource Dim}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- 설정 카드 -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 저장 범위 -->
                <Border Style="{DynamicResource Card}">
                    <StackPanel>
                        <TextBlock Text="스크린샷 저장 범위" Style="{DynamicResource CardTitle}"/>
                        <Border Style="{DynamicResource SegmentBar}" Margin="0,10,0,0" HorizontalAlignment="Stretch">
                            <UniformGrid Rows="1">
                                <RadioButton x:Name="SaveNone" GroupName="save" Content="저장 안 함" Style="{DynamicResource Segment}" Click="Setting_Changed"/>
                                <RadioButton x:Name="SaveArea" GroupName="save" Content="감시 영역만" Style="{DynamicResource Segment}" Click="Setting_Changed"/>
                                <RadioButton x:Name="SaveFull" GroupName="save" Content="전체 화면" Style="{DynamicResource Segment}" Click="Setting_Changed"/>
                            </UniformGrid>
                        </Border>
                        <TextBlock x:Name="SaveHint" Style="{DynamicResource Dim}" Margin="0,8,0,0"/>
                        <DockPanel Margin="0,10,0,0">
                            <Button DockPanel.Dock="Right" Content="열기" Margin="6,0,0,0" Padding="12,6" Click="OpenFolder_Click"/>
                                                        <TextBox x:Name="FolderBox" IsReadOnly="True" ToolTip="저장 폴더는 설정 페이지에서 변경합니다"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- 감도 -->
                <Border Grid.Column="2" Style="{DynamicResource Card}">
                    <StackPanel>
                        <TextBlock Text="감도" Style="{DynamicResource CardTitle}"/>
                        <DockPanel Margin="0,10,0,0">
                            <TextBlock x:Name="ThresholdText" DockPanel.Dock="Right" Width="30" TextAlignment="Right"/>
                            <TextBlock Text="색 변화 기준" ToolTip="작을수록 미세한 색 차이도 변화로 봅니다"/>
                        </DockPanel>
                        <Slider x:Name="ThresholdSlider" Minimum="1" Maximum="64" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="Slider_Changed"/>
                        <DockPanel Margin="0,6,0,0">
                            <TextBlock x:Name="MinPixelsText" DockPanel.Dock="Right" Width="30" TextAlignment="Right"/>
                            <TextBlock Text="최소 변화 픽셀" ToolTip="작을수록 작은 변화(글자 한두 개)도 감지합니다"/>
                        </DockPanel>
                        <Slider x:Name="MinPixelsSlider" Minimum="1" Maximum="500" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="Slider_Changed"/>
                        <TextBlock Text="작을수록 민감" Style="{DynamicResource Dim}"/>
                    </StackPanel>
                </Border>

                <!-- 타이밍 -->
                <Border Grid.Column="4" Style="{DynamicResource Card}">
                    <StackPanel>
                        <TextBlock Text="주기 · 알림" Style="{DynamicResource CardTitle}"/>
                        <TextBlock Text="캡처 주기" Style="{DynamicResource Dim}" Margin="0,10,0,4"/>
                        <ComboBox x:Name="IntervalBox" SelectionChanged="Setting_Changed"/>
                        <TextBlock Text="알림 간격" Style="{DynamicResource Dim}" Margin="0,10,0,4"/>
                        <ComboBox x:Name="AlertBox" SelectionChanged="Setting_Changed"/>
                        <CheckBox x:Name="BeepBox" Content="알림음" Margin="0,12,0,0" Click="Setting_Changed"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
