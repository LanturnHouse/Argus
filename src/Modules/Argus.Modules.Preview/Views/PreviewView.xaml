<UserControl x:Class="Argus.Modules.Preview.PreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- 켜짐/꺼짐을 밝기로 보여주는 버튼: 꺼짐 = 흐리게, 켜짐 = 밝게(강조색) -->
        <Style x:Key="OnOffBase" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="58"/>
            <Setter Property="Padding" Value="0,5"/>
            <Setter Property="Opacity" Value="0.4"/>
        </Style>
        <Style x:Key="CycleBadge" TargetType="Border">
            <Setter Property="MinWidth" Value="20"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="Margin" Value="2,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource Surface3}"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding InCycle}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Accent}"/>
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CycleButton" TargetType="Button" BasedOn="{StaticResource OnOffBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding InCycle}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ShowButton" TargetType="Button" BasedOn="{StaticResource OnOffBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Visible}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <!-- 헤더 -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="EnabledBox" Content="프리뷰 표시" Margin="0,0,18,0" Click="Enabled_Click"/>
                <Button x:Name="EditBtn" Content="배치 편집" Padding="18,9" Click="Edit_Click"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="프리뷰" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="클릭하면 그 클라이언트로 전환됩니다." Style="{DynamicResource Dim}" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- 편집 모드 안내 -->
        <Border x:Name="EditBanner" DockPanel.Dock="Top" Visibility="Collapsed" CornerRadius="10" Padding="16,11" Margin="0,0,0,12"
                Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Accent}" BorderThickness="1">
            <TextBlock TextWrapping="Wrap"
                       Text="배치 편집 중: 끌어서 이동하고 가장자리를 끌어 크기를 바꿉니다. Ctrl+크기 변경은 모든 프리뷰에, Shift+클릭은 그 프리뷰를 기본 크기로 되돌립니다. 끝나면 '배치 편집'을 다시 누르세요."/>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 레이아웃 프리셋 -->
            <Border Style="{DynamicResource Card}" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="16,12" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="레이아웃 프리셋" Style="{DynamicResource CardTitle}"/>
                        </StackPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,0">
                        <StackPanel Margin="8">
                            <ListBox x:Name="PresetList" ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectionChanged="Preset_Selected">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <!-- 선택했거나 마우스를 올린 프리셋에만 이름 변경(연필) · 삭제(휴지통) 아이콘 -->
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <!-- Collapsed 가 아니라 Hidden: 아이콘이 나타나도 줄 높이가 변하지 않아 아래의 + 칸이 밀리지 않는다 -->
                                                        <Setter Property="Visibility" Value="Hidden"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Button Content="&#xE70F;" FontFamily="{DynamicResource IconFont}" Tag="{Binding Id}" Click="RenamePreset_Click"
                                                        ToolTip="이름 변경" Width="28" Height="26" Padding="0" Margin="0,0,2,0" Background="Transparent" BorderBrush="Transparent"/>
                                                <Button Content="&#xE74D;" FontFamily="{DynamicResource IconFont}" Tag="{Binding Id}" Click="DeletePreset_Click"
                                                        ToolTip="삭제" Width="28" Height="26" Padding="0" Background="Transparent" BorderBrush="Transparent"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- 목록 맨 끝의 점선 칸: 눌러서 새 프리셋 (현재 설정을 복사해서 시작) -->
                            <Button Click="NewPreset_Click" Height="44" Margin="0,8,0,0" ToolTip="새 프리셋 (현재 설정을 복사해서 시작)" Cursor="Hand" Focusable="False">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid Background="Transparent">
                                            <Rectangle x:Name="frame" RadiusX="8" RadiusY="8" StrokeThickness="1.5" StrokeDashArray="4,3" Stroke="{DynamicResource TextDim}" Opacity="0.55"/>
                                            <TextBlock Text="&#xE710;" FontFamily="{DynamicResource IconFont}" FontSize="16" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="frame" Property="Stroke" Value="{DynamicResource Accent}"/>
                                                <Setter TargetName="frame" Property="Opacity" Value="1"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- 클라이언트 + 프리셋 설정 -->
            <Border Grid.Column="2" Style="{DynamicResource Card}" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="16,12" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="클라이언트" Style="{DynamicResource CardTitle}"/>
                            <TextBlock Text="≡ 를 끌어 사이클 순서를 바꿉니다. 사이클 버튼이 켜진 클라이언트만 다음/이전 전환에 포함됩니다."
                                       Style="{DynamicResource Dim}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 프리셋 설정 칸: 이 프리셋의 사이클 단축키 -->
                    <Border DockPanel.Dock="Bottom" Padding="16,12" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                        <StackPanel x:Name="PresetBox"/>
                    </Border>

                    <Grid>
                        <TextBlock x:Name="Empty" Style="{DynamicResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Text="실행 중인 EVE 클라이언트가 없습니다."/>
                        <ListBox x:Name="ClientList" Margin="8" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Grid Margin="0,0,0,6">
                                                    <Border x:Name="Row" Background="{DynamicResource Surface2}" CornerRadius="8" Padding="10,9,14,9">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*" MinWidth="120"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 끌어서 순서 바꾸기 -->
                                        <TextBlock Text="&#xE700;" FontFamily="{DynamicResource IconFont}" FontSize="15" Foreground="{DynamicResource TextDim}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" Cursor="SizeAll" ToolTip="끌어서 순서 바꾸기"
                                                   Tag="{Binding Character}" Background="Transparent"
                                                   PreviewMouseLeftButtonDown="Grip_Down" PreviewMouseMove="Grip_Move" PreviewMouseLeftButtonUp="Grip_Up" LostMouseCapture="Grip_LostCapture"/>

                                        <!-- 사이클 순서: 사이클에 포함된 클라이언트만 1, 2, 3… / 빠져 있으면 - (≡ 오른쪽, 줄의 세로 중앙) -->
                                        <Border Grid.Column="1" Style="{StaticResource CycleBadge}" ToolTip="사이클 순서 (사이클이 꺼져 있으면 -)">
                                            <TextBlock Text="{Binding CycleOrder}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Character}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="230" HorizontalAlignment="Left"/>
                                            <TextBlock Text="{Binding Info}" ToolTip="{Binding Info}" Style="{DynamicResource Dim}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- 겹침 경고 -->
                                            <TextBlock Text="&#xE7BA;" FontFamily="{DynamicResource IconFont}" FontSize="15" Foreground="#F5C15A" Margin="0,0,8,0"
                                                       VerticalAlignment="Center" ToolTip="{Binding WarnText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasWarning}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- 이 클라이언트로 바로 가는 단축키 (크기는 고정: 지정 중 문구가 바뀌어도 커지지 않는다) -->
                                            <Button Tag="{Binding Character}" Click="Hotkey_Click" ToolTip="{Binding HotkeyText}" Width="128" Padding="8,5" Margin="0,0,4,0">
                                                <TextBlock Text="{Binding HotkeyText}" TextTrimming="CharacterEllipsis"/>
                                            </Button>
                                            <Button Content="&#xE711;" FontFamily="{DynamicResource IconFont}" Tag="{Binding Character}" Click="HotkeyClear_Click" ToolTip="단축키 지우기"
                                                    Width="28" Padding="0,5" Margin="0,0,14,0" IsEnabled="{Binding HasHotkey}"/>

                                            <!-- 이 프리뷰 위에 그릴 전투 HUD(수치·레드박싱) 고르기 -->
                                            <Button Content="HUD" Tag="{Binding Character}" Click="Hud_Click" Width="58" Padding="0,5" Margin="0,0,6,0"
                                                    ToolTip="이 프리뷰 위에 표시할 전투 수치·레드박싱 경고를 고릅니다"/>

                                            <!-- 사이클 포함 / 표시: 켜면 밝게, 끄면 흐리게 -->
                                            <Button Content="사이클" Style="{StaticResource CycleButton}" Tag="{Binding Character}" Click="InCycle_Click" Margin="0,0,6,0"
                                                    ToolTip="켜면 다음/이전 전환에 포함됩니다"/>
                                            <Button Content="표시" Style="{StaticResource ShowButton}" Tag="{Binding Character}" Click="Visible_Click"
                                                    ToolTip="이 프리셋에서 프리뷰를 보일지"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
